rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /delivery-proofs/{orderId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /promo-ads/{adId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /customer-avatars/{phone}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin'
        // Demo / portal admin uses email+password without custom claims.
        || (request.auth.token.email is string
            && request.auth.token.email.lower() == 'admin@lunchflow.com')
      );
    }

    function isCustomerPhone(phone) {
      return isSignedIn() && request.auth.token.phone == phone;
    }

    function isDriverPhone(phone) {
      return isSignedIn() && request.auth.token.role == 'driver' && request.auth.token.phone == phone;
    }

    match /users/{phone} {
      allow read: if true;
      // Customer/driver registration uses a local phone session before Firebase Auth
      // sign-in, so allow creating/updating the profile by phone.
      allow create: if isAdmin()
        || isCustomerPhone(phone)
        || isDriverPhone(phone)
        || (
          request.resource.data.role == 'customer'
          && request.resource.data.phone == phone
        )
        || (
          request.resource.data.role == 'driver'
          && request.resource.data.phone == phone
        );
      allow update: if isAdmin()
        || isCustomerPhone(phone)
        || isDriverPhone(phone)
        || (
          resource.data.role == 'customer'
          && request.resource.data.role == 'customer'
          && request.resource.data.phone == phone
        )
        || (
          // Keep phone identity; older mirrors may omit role on resource.
          request.resource.data.role == 'driver'
          && request.resource.data.phone == phone
          && (!('phone' in resource.data) || resource.data.phone == phone)
        );
      allow delete: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /drivers/{driverId} {
      allow read: if true;
      // Driver self-registration uses a local phone session before Firebase Auth
      // sign-in (same pattern as customers). Pending/approved docs must sync so
      // admin can review approvals from another device.
      allow create: if isAdmin()
        || isDriverPhone(request.resource.data.phone)
        || (
          request.resource.data.role == 'driver'
          && request.resource.data.phone is string
          && request.resource.data.name is string
        );
      allow update: if isAdmin()
        || isDriverPhone(resource.data.phone)
        || (
          // Admin approvals + driver profile updates (auth optional for phone-keyed docs).
          request.resource.data.role == 'driver'
          && request.resource.data.phone == resource.data.phone
        );
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn() || request.resource.data.customerPhone is string;
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /otpSessions/{phone} {
      allow read, write: if false;
    }

    match /deliverySlots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pricing/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /telecallers/{telecallerId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /telecallerLeads/{leadId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
    }

    match /message_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /users/{phone}/notifications/{notificationId} {
      // Inbox is keyed by phone; allow read for the owner session and mark-as-read updates.
      allow read: if true;
      allow create: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    match /geocodeCache/{addressKey} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /promo_ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
